# Runtime
NODE_ENV=development
PORT=8787
APP_BASE_URL=http://localhost:8888
API_BASE_URL=http://localhost:8787
LOG_LEVEL=info

# Canonical PostgreSQL database
DATABASE_URL=postgres://bet:bet@localhost:5432/bet
DATABASE_SSL=false
DB_POOL_MAX=10

# Authentication provider: dev | supabase
AUTH_PROVIDER=dev
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=authenticated
AUTH_DEV_USER_ID=00000000-0000-4000-8000-000000000001

# AI providers. Keep secrets server-side only.
AI_PROVIDER=disabled
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

TRANSCRIPTION_PROVIDER=disabled
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=
TRANSCRIPTION_BASE_URL=

# Storage provider: local | supabase
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=.tmp/storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=bet-private-media

# Email provider: console | smtp
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=BET <support@example.com>
OWNER_SUPPORT_EMAIL=

# Security
CORS_ALLOWED_ORIGINS=http://localhost:8888
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AI_MAX=30
SESSION_IP_HASH_SECRET=change-me

# Feature flags
FEATURE_SUPPORT_AI=false
FEATURE_LIVE_RESEARCH=false
FEATURE_EMAIL_NOTIFICATIONS=false
FEATURE_PAYMENT_SAFETY_MESSAGING=false
FEATURE_GROUP_DISCUSSIONS=false
